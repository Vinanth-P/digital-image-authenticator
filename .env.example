# Set these explicitly before remote hosting; never commit real secrets.
IMAGEGUARD_ADMIN_USER=admin
IMAGEGUARD_ADMIN_PASSWORD=
IMAGEGUARD_ALLOWED_HOSTS=localhost,127.0.0.1,::1
IMAGEGUARD_BASE_URL=http://localhost:8000
# Optional separate runtime/cache locations:
# IMAGEGUARD_DATA_DIR=/data
# IMAGEGUARD_MODELS_DIR=/data/models
# MASTER_PEPPER=<at least 32 random characters; otherwise installation-local secret is generated>
# Remote TSA tokens are labelled received_unverified until trust validation exists.
# RFC3161_TSA_URL=
